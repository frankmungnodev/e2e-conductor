{
  "name": "e2e-conductor",
  "version": "0.2.0",
  "description": "Run one JSON scenario across HTTP APIs, web apps (Playwright) and Android apps (adb)",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "playwright",
    "android",
    "adb",
    "api-testing"
  ],
  "license": "MIT",
  "author": "frankmungnodev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankmungnodev/e2e-conductor.git"
  },
  "homepage": "https://github.com/frankmungnodev/e2e-conductor#readme",
  "bugs": {
    "url": "https://github.com/frankmungnodev/e2e-conductor/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "e2e": "./bin/e2e.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "ui/dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:size": "node scripts/check-size.mjs",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:ui": "pnpm run build:ui && node --import tsx --test \"test/ui/*.test.ts\"",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "lint": "biome lint",
    "check": "pnpm run typecheck && pnpm run check:boundary && pnpm run check:size && pnpm run check:tailwind && pnpm test",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check:tailwind": "node scripts/check-tailwind.mjs",
    "prepublishOnly": "pnpm run check && pnpm run build:ui"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
